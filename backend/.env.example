# Backend environment example for ApuesTec.
# Copy to .env only in local environments. Do not commit real secrets.

APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://apuestec_user:apuestec_password@postgres:5432/apuestec?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

GOOGLE_CLIENT_ID=change_me_google_client_id
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

CORS_ALLOWED_ORIGINS=http://localhost:3000
