# Backend environment example for ApuesTec.
# Copy to .env only in local environments. Do not commit real secrets.

APP_NAME=apuestec-backend
APP_ENV=development
APP_PORT=8080
API_PREFIX=/api/v1

APP_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

DATABASE_URL=postgres://apuestec_user:apuestec_password@postgres:5432/apuestec?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

PASSWORD_HASH_ALGO=bcrypt
BCRYPT_COST=12

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

GOOGLE_CLIENT_ID=

# Optional only if using OAuth authorization-code redirect flow.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

LOG_LEVEL=debug
